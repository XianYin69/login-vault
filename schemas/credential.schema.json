{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "login_vault_credential",
  "description": "login-vault 加密库解密后的条目契约（仅存在于进程内存；磁盘只有 vault.json.enc）",
  "type": "object",
  "required": ["id", "user", "secret", "created"],
  "properties": {
    "id": { "type": "string", "description": "站点/服务标识（唯一键）" },
    "user": { "type": "string", "description": "账号（邮箱/用户名）" },
    "secret": { "type": "string", "description": "口令/令牌明文（仅 get --yes 输出并记审计）" },
    "url": { "type": "string" },
    "note": { "type": "string", "description": "备注（禁止粘贴助记词/私钥等不可重置秘密）" },
    "created": { "type": "string", "format": "date" },
    "rotated": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
